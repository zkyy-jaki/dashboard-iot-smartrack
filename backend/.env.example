# ==============================================================================
# SMARTRACK WMS BACKEND — PUSAT KONFIGURASI ENVIRONMENT (.env)
# Salin file ini menjadi `.env` lalu sesuaikan nilai dengan lingkungan Anda.
# ==============================================================================

# Port server REST API & WebSocket Express
PORT=3001
NODE_ENV=development

# Origin domain Frontend React (Vite / Vercel) yang diizinkan CORS
CORS_ORIGIN=http://localhost:5173

# Database SQLite (Prisma ORM)
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# KONFIGURASI FISIK RAK (PENTING)
# Ubah jika panjang rak fisik berbeda dari prototipe 58 cm
# ------------------------------------------------------------------------------
DEFAULT_ROW_SPAN_CM=58
DEFAULT_ROW_CAPACITY=6

# ------------------------------------------------------------------------------
# BROKER MQTT (Tempat ESP32 mem-publish telemetri sensor)
# Ganti IP di bawah sesuai IP server/komputer yang menjalankan Mosquitto
# ------------------------------------------------------------------------------
MQTT_BROKER_URL=mqtt://192.168.10.50:1883
MQTT_CLIENT_ID=smartrack-backend-01
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_RECONNECT_PERIOD_MS=5000
MQTT_KEEPALIVE_SECS=60

# ------------------------------------------------------------------------------
# AMBANG BATAS KESELAMATAN (Memicu Lampu Merah Kedip & Buzzer)
# ------------------------------------------------------------------------------
TEMP_DANGER_THRESHOLD_C=50.0
GAS_WARNING_THRESHOLD_PPM=350
GAS_DANGER_THRESHOLD_PPM=600
